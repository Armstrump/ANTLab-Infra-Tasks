import requests
import time
import json

# API 配置
API_URL = "http://localhost:8080/v1/chat/completions"
PROMPT = "你好，请用中文介绍一下你自己"
OUTPUT_FILE = "results/run_001.json"

# 请求参数
payload = {
    "model": "default",
    "messages": [
        {"role": "user", "content": PROMPT}
    ],
    "stream": True,
    "stream_options": {
        "include_usage": True
    }
}

# 记录开始时间
start_time = time.perf_counter()
first_token_time = None
output_content = ""
generated_tokens = 0

try:
    # 发送流式请求
    response = requests.post(
        API_URL,
        json=payload,
        stream=True,
        timeout=300
    )
    response.raise_for_status()

    # 逐行读取 SSE 响应
    for line in response.iter_lines(decode_unicode=True):
        if not line:
            continue

        if isinstance(line, bytes):
            line = line.decode("utf-8")

        if not line.startswith("data:"):
            continue

        data = line[len("data:"):].strip()

        if data == "[DONE]":
            break

        try:
            chunk = json.loads(data)
        except json.JSONDecodeError:
            continue

        # 记录服务端返回的 token 使用量
        usage = chunk.get("usage")
        if usage and usage.get("completion_tokens") is not None:
            generated_tokens = usage["completion_tokens"]

        choices = chunk.get("choices", [])
        if not choices:
            continue

        delta = choices[0].get("delta", {})
        content = delta.get("content", "")

        if content:
            # 首次收到非空文本的时间
            if first_token_time is None:
                first_token_time = time.perf_counter()

            output_content += content

            # 若服务端没有返回 usage，使用非空内容块数
            # 作为近似值，而不是准确的 token 数
            if generated_tokens == 0:
                pass

    end_time = time.perf_counter()

    # 计算耗时
    total_time = end_time - start_time

    ttft = (
        first_token_time - start_time
        if first_token_time is not None
        else None
    )

    # 如果服务端没有返回 usage，token 数无法准确获知
    token_count_source = "server_usage"
    if generated_tokens == 0:
        token_count_source = "unavailable"
        generated_tokens = None

    # 组织结果
    result = {
        "prompt": PROMPT,
        "ttft_seconds": round(ttft, 6) if ttft is not None else None,
        "total_time_seconds": round(total_time, 6),
        "generated_tokens": generated_tokens,
        "token_count_source": token_count_source,
        "output": output_content
    }

    # 创建输出目录并保存结果
    import os
    os.makedirs("results", exist_ok=True)

    with open(OUTPUT_FILE, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=4)

    print(json.dumps(result, ensure_ascii=False, indent=4))
    print(f"\n结果已保存到 {OUTPUT_FILE}")

except requests.RequestException as e:
    print(f"API 请求失败: {e}")output_content = ""
generated_tokens = 0

try:
    # 发送流式请求
    response = requests.post(
        API_URL,
        json=payload,
        stream=True,
        timeout=300
    )
